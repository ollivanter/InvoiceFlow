# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values: .env is git-ignored.

# Postgres connection string (Neon: use the *pooled* connection string, with sslmode=require)
DATABASE_URL=postgres://invoiceflow:invoiceflow@localhost:5432/invoiceflow

# Required in production. Generate each with: openssl rand -base64 32
APP_SECRET=
DATA_ENCRYPTION_KEY=

# Public URL used in email links, e.g. https://invoiceflow.example.com
APP_URL=

# Email delivery — pick ONE. Without either, codes are only printed to the dev console.
# Option A (free, no domain needed): a Gmail account with 2-Step Verification + an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B (needs a verified domain): https://resend.com
RESEND_API_KEY=
# Optional. With Gmail it must be the same address as SMTP_USER.
MAIL_FROM=

# Optional bot protection (https://developers.cloudflare.com/turnstile/)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to 1 only for a private demo: shows verification codes in the browser in production.
OTP_DEMO=
